<?php
/**
 * Protected article-only lifecycle extension for NKT GPT Connector 0.7.24.
 *
 * Loaded by the primary connector after the one-time upgrader patches 0.7.23.
 * Internal function and metadata names retain the 0723 suffix so existing
 * protected 0.7.23 drafts remain readable and resumable without migration.
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

if ( ! defined( 'NKT_GPT_CONNECTOR_VERSION' ) || '0.7.24' !== NKT_GPT_CONNECTOR_VERSION ) {
	return;
}

const NKT_GPT_PAR_0723_BASELINE_META  = '_nkt_par_0723_baseline';
const NKT_GPT_PAR_0723_LIFECYCLE_META = '_nkt_par_0723_lifecycle';
const NKT_GPT_PAR_0723_BACKUP_META    = '_nkt_par_0723_live_backup';
const NKT_GPT_PAR_0723_VERSION         = '0.7.24';
const NKT_GPT_PAR_0723_RECIPE_HASH_VERSION = 'nkt-wprm-object-v1';
const NKT_GPT_PAR_0723_RECIPE_COMPONENT_VERSION = 'nkt-wprm-components-v1';
const NKT_GPT_PAR_0723_RECIPE_REPAIR_META = '_nkt_par_0723_recipe_status_repair';

