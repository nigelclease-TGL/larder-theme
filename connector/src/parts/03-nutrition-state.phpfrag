function nkt_gpt_par_0723_block_text( $block ) {
	$html = isset( $block['innerHTML'] ) ? (string) $block['innerHTML'] : '';
	return trim( preg_replace( '/\s+/u', ' ', html_entity_decode( wp_strip_all_tags( $html ), ENT_QUOTES | ENT_HTML5, get_bloginfo( 'charset' ) ?: 'UTF-8' ) ) );
}

/** Normalize visible heading text from raw or parsed Gutenberg markup. */
function nkt_gpt_par_0723_visible_heading_text( $html ) {
	return trim( preg_replace( '/\s+/u', ' ', html_entity_decode( wp_strip_all_tags( (string) $html ), ENT_QUOTES | ENT_HTML5, get_bloginfo( 'charset' ) ?: 'UTF-8' ) ) );
}

/** Convert one visible H3 into a serving candidate when it matches exactly. */
function nkt_gpt_par_0723_serving_heading_candidate( $visible_text, $source, $block_path = null ) {
	$visible_text = trim( preg_replace( '/\s+/u', ' ', (string) $visible_text ) );
	if ( ! preg_match( '/^Serving\s*:\s*(.+)$/iu', $visible_text, $match ) ) {
		return array();
	}
	$label = trim( preg_replace( '/\s+/u', ' ', $match[1] ) );
	if ( '' === $label ) {
		return array();
	}
	return array(
		'serving_label'            => $label,
		'serving_label_hash'       => hash( 'sha256', $label ),
		'serving_label_source'     => (string) $source,
		'serving_label_block_path' => null === $block_path ? null : (string) $block_path,
		'visible_heading_text'     => $visible_text,
	);
}

/** Recursively collect every parsed Gutenberg H3 whose visible text is Serving: <label>. */
function nkt_gpt_par_0723_collect_serving_headings_in_blocks( $blocks, $path_prefix = array() ) {
	$candidates = array();
	foreach ( (array) $blocks as $index => $block ) {
		$path = array_merge( $path_prefix, array( (int) $index ) );
		if ( 'core/heading' === (string) ( $block['blockName'] ?? '' ) ) {
			$level = isset( $block['attrs']['level'] ) ? absint( $block['attrs']['level'] ) : 2;
			if ( 3 === $level ) {
				$candidate = nkt_gpt_par_0723_serving_heading_candidate(
					nkt_gpt_par_0723_block_text( $block ),
					'parsed_article_heading',
					implode( '.', $path )
				);
				if ( $candidate ) {
					$candidates[] = $candidate;
				}
			}
		}
		$inner = isset( $block['innerBlocks'] ) ? (array) $block['innerBlocks'] : array();
		if ( $inner ) {
			$candidates = array_merge( $candidates, nkt_gpt_par_0723_collect_serving_headings_in_blocks( $inner, $path ) );
		}
	}
	return $candidates;
}

/** Collect every raw H3 whose normalized visible text is Serving: <label>. */
function nkt_gpt_par_0723_collect_raw_serving_h3_candidates( $content ) {
	$candidates = array();
	if ( ! preg_match_all( '/<h3\b[^>]*>(.*?)<\/h3>/isu', (string) $content, $headings, PREG_SET_ORDER ) ) {
		return $candidates;
	}
	foreach ( $headings as $index => $heading ) {
		$candidate = nkt_gpt_par_0723_serving_heading_candidate(
			nkt_gpt_par_0723_visible_heading_text( $heading[1] ),
			'raw_article_h3',
			null
		);
		if ( $candidate ) {
			$candidate['raw_heading_index'] = (int) $index;
			$candidates[] = $candidate;
		}
	}
	return $candidates;
}

/**
 * Prove a unique raw Nutrition presentation immediately following one raw
 * Serving H3 when the legacy parser reports zero Nutrition sections.
 */
function nkt_gpt_par_0723_zero_section_nutrition_signature( $content ) {
	$evidence = array(
		'serving_label'                                  => '',
		'serving_fallback_raw_serving_h3_count'           => 0,
		'serving_fallback_segment_nutrition_marker_count' => 0,
		'serving_fallback_article_nutrition_marker_count' => 0,
		'serving_fallback_nutrient_label_count'           => 0,
		'serving_fallback_daily_value_marker_count'       => 0,
		'serving_fallback_calorie_basis_count'            => 0,
		'serving_fallback_signature_accepted'             => false,
		'serving_fallback_signature_rejection_reason'     => null,
	);
	if ( ! preg_match_all( '/<h3\b[^>]*>(.*?)<\/h3>/isu', (string) $content, $headings, PREG_SET_ORDER | PREG_OFFSET_CAPTURE ) ) {
		$evidence['serving_fallback_signature_rejection_reason'] = 'no_raw_serving_h3';
		return $evidence;
	}

	$serving_headings = array();
	foreach ( $headings as $heading ) {
		$candidate = nkt_gpt_par_0723_serving_heading_candidate(
			nkt_gpt_par_0723_visible_heading_text( $heading[1][0] ),
			'raw_article_h3',
			null
		);
		if ( $candidate ) {
			$candidate['raw_full_markup'] = (string) $heading[0][0];
			$candidate['raw_offset']      = (int) $heading[0][1];
			$serving_headings[] = $candidate;
		}
	}
	$evidence['serving_fallback_raw_serving_h3_count'] = count( $serving_headings );
	if ( 1 !== count( $serving_headings ) ) {
		$evidence['serving_fallback_signature_rejection_reason'] = count( $serving_headings ) > 1
			? 'raw_serving_h3_not_unique'
			: 'no_raw_serving_h3';
		return $evidence;
	}

	$candidate = $serving_headings[0];
	$evidence['serving_label'] = $candidate['serving_label'];
	$start = $candidate['raw_offset'] + strlen( $candidate['raw_full_markup'] );
	$tail  = substr( (string) $content, $start );
	if ( preg_match( '/<h[23]\b/iu', $tail, $next_heading, PREG_OFFSET_CAPTURE ) ) {
		$tail = substr( $tail, 0, (int) $next_heading[0][1] );
	}
	$segment_text = nkt_gpt_par_0723_visible_heading_text( $tail );
	$article_text = nkt_gpt_par_0723_visible_heading_text( $content );

	preg_match_all( '/Nutrition\s+per\s+serving/iu', $segment_text, $segment_markers );
	preg_match_all( '/Nutrition\s+per\s+serving/iu', $article_text, $article_markers );
	preg_match_all( '/(?:Percent|%)\s+Daily\s+Values?\b/iu', $segment_text, $daily_markers );
	preg_match_all( '/\b2,?000(?:-|\s)+calorie\s+diet\b/iu', $segment_text, $calorie_markers );
	$evidence['serving_fallback_segment_nutrition_marker_count'] = count( $segment_markers[0] );
	$evidence['serving_fallback_article_nutrition_marker_count'] = count( $article_markers[0] );
	$evidence['serving_fallback_daily_value_marker_count']       = count( $daily_markers[0] );
	$evidence['serving_fallback_calorie_basis_count']            = count( $calorie_markers[0] );

	$nutrient_count = 0;
	foreach ( array( 'Calories', 'Total Fat', 'Carbohydrates', 'Carbs', 'Sugars', 'Protein', 'Sodium', 'Fiber', 'Fibre' ) as $label ) {
		if ( preg_match( '/' . preg_quote( $label, '/' ) . '\s*:/iu', $segment_text ) ) {
			$nutrient_count++;
		}
	}
	$evidence['serving_fallback_nutrient_label_count'] = $nutrient_count;

	if ( 1 !== $evidence['serving_fallback_segment_nutrition_marker_count']
		|| 1 !== $evidence['serving_fallback_article_nutrition_marker_count'] ) {
		$evidence['serving_fallback_signature_rejection_reason'] = 'nutrition_per_serving_marker_not_unique';
		return $evidence;
	}
	if ( 4 > $nutrient_count ) {
		$evidence['serving_fallback_signature_rejection_reason'] = 'insufficient_nutrient_labels';
		return $evidence;
	}
	if ( 1 !== $evidence['serving_fallback_daily_value_marker_count'] ) {
		$evidence['serving_fallback_signature_rejection_reason'] = 'daily_value_marker_not_unique';
		return $evidence;
	}
	if ( 1 !== $evidence['serving_fallback_calorie_basis_count'] ) {
		$evidence['serving_fallback_signature_rejection_reason'] = 'calorie_basis_marker_not_unique';
		return $evidence;
	}
	$evidence['serving_fallback_signature_accepted'] = true;
	return $evidence;
}

/** Find a unique H3 Serving heading inside a nested block list. */
function nkt_gpt_par_0723_find_serving_heading_in_blocks( $blocks, $path_prefix = array() ) {
	$candidates = nkt_gpt_par_0723_collect_serving_headings_in_blocks( $blocks, $path_prefix );
	if ( 1 !== count( $candidates ) ) {
		return array();
	}
	$candidate = $candidates[0];
	$candidate['serving_label_source'] = 'nutrition_heading';
	unset( $candidate['visible_heading_text'] );
	return $candidate;
}

/**
 * Extract serving evidence from the recognized Nutrition section. When the
 * legacy parser reports zero sections, accept only a unique Serving H3 with a
 * unique, strongly corroborated Nutrition presentation immediately after it.
 */
function nkt_gpt_par_0723_extract_nutrition_serving_heading( $content, $nutrition_section_count = null ) {
	$result = array(
		'serving_label'                                  => '',
		'serving_label_hash'                             => hash( 'sha256', '' ),
		'serving_label_source'                           => null,
		'serving_label_block_path'                       => null,
		'parsed_nutrition_section_count'                 => null === $nutrition_section_count ? null : (int) $nutrition_section_count,
		'matching_visible_serving_h3_count'              => 0,
		'serving_fallback_accepted'                      => false,
		'serving_fallback_rejection_reason'              => null,
		'serving_fallback_gate'                          => null,
		'serving_fallback_raw_serving_h3_count'           => null,
		'serving_fallback_segment_nutrition_marker_count' => null,
		'serving_fallback_article_nutrition_marker_count' => null,
		'serving_fallback_nutrient_label_count'           => null,
		'serving_fallback_daily_value_marker_count'       => null,
		'serving_fallback_calorie_basis_count'            => null,
		'serving_fallback_signature_accepted'             => null,
		'serving_fallback_signature_rejection_reason'     => null,
	);
	$blocks = function_exists( 'parse_blocks' ) ? parse_blocks( (string) $content ) : array();

	// Primary extraction: preserve the existing top-level NUTRITION traversal.
	if ( $blocks ) {
		$inside_nutrition = false;
		$primary_candidates = array();
		foreach ( (array) $blocks as $index => $block ) {
			if ( 'core/heading' === (string) ( $block['blockName'] ?? '' ) ) {
				$level = isset( $block['attrs']['level'] ) ? absint( $block['attrs']['level'] ) : 2;
				$text  = nkt_gpt_par_0723_block_text( $block );
				if ( ! $inside_nutrition && 2 === $level && 'NUTRITION' === strtoupper( $text ) ) {
					$inside_nutrition = true;
					continue;
				}
				if ( $inside_nutrition && $level <= 2 ) {
					break;
				}
			}
			if ( $inside_nutrition ) {
				$primary_candidates = array_merge(
					$primary_candidates,
					nkt_gpt_par_0723_collect_serving_headings_in_blocks( array( $block ), array( (int) $index ) )
				);
			}
		}
		if ( 1 === count( $primary_candidates ) ) {
			$candidate = $primary_candidates[0];
			$result['serving_label'] = $candidate['serving_label'];
			$result['serving_label_hash'] = $candidate['serving_label_hash'];
			$result['serving_label_source'] = 'nutrition_heading';
			$result['serving_label_block_path'] = $candidate['serving_label_block_path'];
			$result['matching_visible_serving_h3_count'] = 1;
			return $result;
		}
		if ( count( $primary_candidates ) > 1 ) {
			$result['matching_visible_serving_h3_count'] = count( $primary_candidates );
			$result['serving_fallback_rejection_reason'] = 'multiple_serving_h3_in_primary_nutrition_section';
			return $result;
		}
	}

	// Existing raw section-scoped fallback, tolerant of nested inline markup.
	if ( preg_match( '/<h2\b[^>]*>\s*NUTRITION\s*<\/h2>(.*?)(?=<h2\b|\z)/isu', (string) $content, $section ) ) {
		$section_candidates = nkt_gpt_par_0723_collect_raw_serving_h3_candidates( $section[1] );
		if ( 1 === count( $section_candidates ) ) {
			$candidate = $section_candidates[0];
			$result['serving_label'] = $candidate['serving_label'];
			$result['serving_label_hash'] = $candidate['serving_label_hash'];
			$result['serving_label_source'] = 'nutrition_heading_fallback';
			$result['matching_visible_serving_h3_count'] = 1;
			return $result;
		}
		if ( count( $section_candidates ) > 1 ) {
			$result['matching_visible_serving_h3_count'] = count( $section_candidates );
			$result['serving_fallback_rejection_reason'] = 'multiple_serving_h3_in_raw_nutrition_section';
			return $result;
		}
	}

	$article_candidates = $blocks ? nkt_gpt_par_0723_collect_serving_headings_in_blocks( $blocks ) : array();
	if ( ! $article_candidates ) {
		$article_candidates = nkt_gpt_par_0723_collect_raw_serving_h3_candidates( $content );
	}
	$result['matching_visible_serving_h3_count'] = count( $article_candidates );
	if ( 1 !== count( $article_candidates ) ) {
		$result['serving_fallback_rejection_reason'] = count( $article_candidates ) > 1
			? 'multiple_visible_serving_h3_candidates'
			: 'no_visible_serving_h3_candidate';
		return $result;
	}

	if ( null === $nutrition_section_count ) {
		$result['serving_fallback_rejection_reason'] = 'nutrition_section_count_unavailable';
		return $result;
	}
	if ( 1 < (int) $nutrition_section_count ) {
		$result['serving_fallback_rejection_reason'] = 'nutrition_section_count_not_unique';
		return $result;
	}

	$candidate = $article_candidates[0];
	if ( 1 === (int) $nutrition_section_count ) {
		$result['serving_label'] = $candidate['serving_label'];
		$result['serving_label_hash'] = $candidate['serving_label_hash'];
		$result['serving_label_source'] = 'unique_article_serving_h3_with_single_nutrition_section';
		$result['serving_label_block_path'] = $candidate['serving_label_block_path'];
		$result['serving_fallback_accepted'] = true;
		$result['serving_fallback_gate'] = 'single_legacy_nutrition_section';
		return $result;
	}

	$signature = nkt_gpt_par_0723_zero_section_nutrition_signature( $content );
	foreach ( $signature as $key => $value ) {
		if ( 0 === strpos( $key, 'serving_fallback_' ) ) {
			$result[ $key ] = $value;
		}
	}
	if ( ! $signature['serving_fallback_signature_accepted'] ) {
		$result['serving_fallback_rejection_reason'] = $signature['serving_fallback_signature_rejection_reason'];
		return $result;
	}
	if ( $candidate['serving_label'] !== $signature['serving_label'] ) {
		$result['serving_fallback_rejection_reason'] = 'serving_candidate_signature_label_mismatch';
		return $result;
	}

	$result['serving_label'] = $candidate['serving_label'];
	$result['serving_label_hash'] = $candidate['serving_label_hash'];
	$result['serving_label_source'] = 'unique_article_serving_h3_with_unique_nutrition_presentation';
	$result['serving_label_block_path'] = $candidate['serving_label_block_path'];
	$result['serving_fallback_accepted'] = true;
	$result['serving_fallback_gate'] = 'legacy_parser_zero_unique_nutrition_presentation';
	$result['serving_fallback_rejection_reason'] = null;
	return $result;
}

/** Extract a position-independent Nutrition manifest using the connector's parser. */
function nkt_gpt_par_0723_nutrition_manifest( $content ) {
	$parsed = function_exists( 'nkt_gpt_connector_legacy_nutrition_article_sections' )
		? nkt_gpt_connector_legacy_nutrition_article_sections( (string) $content, true )
		: array();

	$sections = array();
	foreach ( (array) ( isset( $parsed['nutrition_sections'] ) ? $parsed['nutrition_sections'] : array() ) as $section ) {
		$blocks = array();
		foreach ( (array) ( isset( $section['blocks'] ) ? $section['blocks'] : array() ) as $block ) {
			$blocks[] = array(
				'block_name'     => isset( $block['block_name'] ) ? $block['block_name'] : null,
				'text_sha256'    => isset( $block['text_sha256'] ) ? $block['text_sha256'] : null,
				'raw_sha256'     => isset( $block['raw_sha256'] ) ? $block['raw_sha256'] : null,
				'recipe_id'      => isset( $block['recipe_id'] ) ? $block['recipe_id'] : null,
				'attachment_ids' => isset( $block['attachment_ids'] ) ? array_values( (array) $block['attachment_ids'] ) : array(),
			);
		}
		$sections[] = array(
			'heading'                     => isset( $section['heading'] ) ? $section['heading'] : '',
			'heading_level'               => isset( $section['heading_level'] ) ? $section['heading_level'] : null,
			'section_text_sha256'         => isset( $section['section_text_sha256'] ) ? $section['section_text_sha256'] : '',
			'recipe_ids_inside_section'   => array_values( (array) ( isset( $section['recipe_ids_inside_section'] ) ? $section['recipe_ids_inside_section'] : array() ) ),
			'nearest_preceding_recipe_id' => isset( $section['nearest_preceding_recipe_id'] ) ? $section['nearest_preceding_recipe_id'] : null,
			'nearest_following_recipe_id' => isset( $section['nearest_following_recipe_id'] ) ? $section['nearest_following_recipe_id'] : null,
			'serving_phrases'             => array_values( (array) ( isset( $section['serving_phrases'] ) ? $section['serving_phrases'] : array() ) ),
			'daily_value_phrases'         => array_values( (array) ( isset( $section['daily_value_phrases'] ) ? $section['daily_value_phrases'] : array() ) ),
			'disclaimer_phrases'          => array_values( (array) ( isset( $section['disclaimer_phrases'] ) ? $section['disclaimer_phrases'] : array() ) ),
			'nutrient_label_hits'         => array_values( (array) ( isset( $section['nutrient_label_hits'] ) ? $section['nutrient_label_hits'] : array() ) ),
			'attachments'                 => array_values( (array) ( isset( $section['attachments'] ) ? $section['attachments'] : array() ) ),
			'blocks'                      => $blocks,
		);
	}

	$outside = array();
	foreach ( (array) ( isset( $parsed['nutrition_like_blocks_outside_sections'] ) ? $parsed['nutrition_like_blocks_outside_sections'] : array() ) as $block ) {
		$outside[] = array(
			'block_name'     => isset( $block['block_name'] ) ? $block['block_name'] : null,
			'text_sha256'    => isset( $block['text_sha256'] ) ? $block['text_sha256'] : null,
			'raw_sha256'     => isset( $block['raw_sha256'] ) ? $block['raw_sha256'] : null,
			'recipe_id'      => isset( $block['recipe_id'] ) ? $block['recipe_id'] : null,
			'attachment_ids' => isset( $block['attachment_ids'] ) ? array_values( (array) $block['attachment_ids'] ) : array(),
		);
	}

	$serving = nkt_gpt_par_0723_extract_nutrition_serving_heading( $content, count( $sections ) );

	$manifest = array(
		'nutrition_sections'                     => $sections,
		'nutrition_like_blocks_outside_sections' => $outside,
	);
	return array(
		'sections'      => $manifest,
		'section_hash'  => nkt_gpt_par_0723_hash( $manifest ),
		'serving_label' => $serving['serving_label'],
		'serving_hash'  => $serving['serving_label_hash'],
		'serving_label_source' => $serving['serving_label_source'],
		'serving_label_block_path' => $serving['serving_label_block_path'],
		'parsed_nutrition_section_count' => $serving['parsed_nutrition_section_count'],
		'matching_visible_serving_h3_count' => $serving['matching_visible_serving_h3_count'],
		'serving_fallback_accepted' => $serving['serving_fallback_accepted'],
		'serving_fallback_rejection_reason' => $serving['serving_fallback_rejection_reason'],
		'serving_fallback_gate' => $serving['serving_fallback_gate'],
		'serving_fallback_raw_serving_h3_count' => $serving['serving_fallback_raw_serving_h3_count'],
		'serving_fallback_segment_nutrition_marker_count' => $serving['serving_fallback_segment_nutrition_marker_count'],
		'serving_fallback_article_nutrition_marker_count' => $serving['serving_fallback_article_nutrition_marker_count'],
		'serving_fallback_nutrient_label_count' => $serving['serving_fallback_nutrient_label_count'],
		'serving_fallback_daily_value_marker_count' => $serving['serving_fallback_daily_value_marker_count'],
		'serving_fallback_calorie_basis_count' => $serving['serving_fallback_calorie_basis_count'],
		'serving_fallback_signature_accepted' => $serving['serving_fallback_signature_accepted'],
		'serving_fallback_signature_rejection_reason' => $serving['serving_fallback_signature_rejection_reason'],
	);
}

/** Hash SEO-related metadata. */
function nkt_gpt_par_0723_seo_hash( $post_id ) {
	return nkt_gpt_par_0723_hash(
		nkt_gpt_par_0723_selected_post_meta( $post_id, '/(?:^_yoast_wpseo_|^rank_math_|^_aioseo_|seo)/i' )
	);
}

/** Hash schema and JSON-LD metadata. */
function nkt_gpt_par_0723_schema_hash( $post_id ) {
	return nkt_gpt_par_0723_hash(
		nkt_gpt_par_0723_selected_post_meta( $post_id, '/(?:schema|json.?ld|structured.?data|rank_math_schema)/i' )
	);
}

/** Hash ratings and review evidence without returning comment bodies. */
function nkt_gpt_par_0723_ratings_reviews_state( $post_id ) {
	$comments = get_comments(
		array(
			'post_id' => absint( $post_id ),
			'status'  => 'all',
			'orderby' => 'comment_ID',
			'order'   => 'ASC',
		)
	);
	$rows = array();
	foreach ( $comments as $comment ) {
		$rating_meta = array();
		foreach ( get_comment_meta( $comment->comment_ID ) as $key => $values ) {
			if ( preg_match( '/rating|review/i', (string) $key ) ) {
				$rating_meta[ $key ] = array_map( 'maybe_unserialize', (array) $values );
			}
		}
		$rows[] = array(
			'id'           => (int) $comment->comment_ID,
			'approved'     => (string) $comment->comment_approved,
			'type'         => (string) $comment->comment_type,
			'parent'       => (int) $comment->comment_parent,
			'date_gmt'     => (string) $comment->comment_date_gmt,
			'content_hash' => hash( 'sha256', (string) $comment->comment_content ),
			'meta'         => $rating_meta,
		);
	}
	return array(
		'count' => count( $rows ),
		'hash'  => nkt_gpt_par_0723_hash( $rows ),
	);
}

/** Capture all protected fields for one live article. */
function nkt_gpt_par_0723_capture_live_state( $post_id ) {
	$post = get_post( $post_id );
	if ( ! $post || 'post' !== $post->post_type ) {
		return new WP_Error( 'nkt_gpt_par_live_not_found', __( 'The live post was not found.', 'nkt-gpt-connector' ), array( 'status' => 404 ) );
	}

	$recipe_ids    = function_exists( 'nkt_gpt_connector_get_wprm_recipe_ids' ) ? nkt_gpt_connector_get_wprm_recipe_ids( $post->post_content ) : array();
	$recipe_hashes = nkt_gpt_par_0723_recipe_hashes( $recipe_ids );
	$nutrition     = nkt_gpt_par_0723_nutrition_manifest( $post->post_content );
	$media         = nkt_gpt_par_0723_media_manifest( $post->post_content );
	$amazon        = nkt_gpt_par_0723_amazon_manifest( $post->post_content );
	$expanded_links = nkt_gpt_par_0723_expand_reusable_blocks( $post->post_content );
	$links         = nkt_gpt_par_0723_link_manifest( $expanded_links['expanded_content'], $post_id );
	$ratings       = nkt_gpt_par_0723_ratings_reviews_state( $post_id );
	$protected_meta= nkt_gpt_par_0723_post_meta_snapshot( $post_id );
	$exception     = function_exists( 'nkt_gpt_connector_intentional_multi_recipe_state' )
		? nkt_gpt_connector_intentional_multi_recipe_state( $post_id, $recipe_ids )
		: array( 'active' => false, 'valid' => true, 'stale' => false, 'exact_recipe_ids_match' => true );

	return array(
		'live_post_id'              => (int) $post->ID,
		'status'                    => $post->post_status,
		'slug'                      => $post->post_name,
		'permalink'                 => get_permalink( $post ),
		'publication_date'          => get_post_time( DATE_ATOM, true, $post ),
		'featured_media_id'         => (int) get_post_thumbnail_id( $post_id ),
		'comment_status'            => $post->comment_status,
		'ping_status'               => $post->ping_status,
		'title_hash'                => hash( 'sha256', (string) $post->post_title ),
		'content_hash'              => hash( 'sha256', (string) $post->post_content ),
		'excerpt_hash'              => hash( 'sha256', (string) $post->post_excerpt ),
		'ordered_wprm_recipe_ids'   => array_values( array_map( 'absint', $recipe_ids ) ),
		'wprm_reference_count'      => count( $recipe_ids ),
		'recipe_object_hash_version' => $recipe_hashes['object_hash_version'],
		'recipe_component_hash_version' => $recipe_hashes['component_hash_version'],
		'recipe_object_hashes'      => $recipe_hashes['object_hashes'],
		'recipe_statuses'           => $recipe_hashes['statuses'],
		'recipe_identities'         => $recipe_hashes['identities'],
		'recipe_component_hashes'   => $recipe_hashes['component_hashes'],
		'recipe_status_independent_hashes' => $recipe_hashes['status_independent_hashes'],
		'wprm_nutrition_hashes'     => $recipe_hashes['nutrition_hashes'],
		'nutrition_section_hash'    => $nutrition['section_hash'],
		'serving_label'             => $nutrition['serving_label'],
		'serving_label_hash'        => $nutrition['serving_hash'],
		'serving_label_source'      => $nutrition['serving_label_source'],
		'serving_label_block_path'  => $nutrition['serving_label_block_path'],
		'parsed_nutrition_section_count' => $nutrition['parsed_nutrition_section_count'],
		'matching_visible_serving_h3_count' => $nutrition['matching_visible_serving_h3_count'],
		'serving_fallback_accepted' => $nutrition['serving_fallback_accepted'],
		'serving_fallback_rejection_reason' => $nutrition['serving_fallback_rejection_reason'],
		'serving_fallback_gate' => $nutrition['serving_fallback_gate'],
		'serving_fallback_raw_serving_h3_count' => $nutrition['serving_fallback_raw_serving_h3_count'],
		'serving_fallback_segment_nutrition_marker_count' => $nutrition['serving_fallback_segment_nutrition_marker_count'],
		'serving_fallback_article_nutrition_marker_count' => $nutrition['serving_fallback_article_nutrition_marker_count'],
		'serving_fallback_nutrient_label_count' => $nutrition['serving_fallback_nutrient_label_count'],
		'serving_fallback_daily_value_marker_count' => $nutrition['serving_fallback_daily_value_marker_count'],
		'serving_fallback_calorie_basis_count' => $nutrition['serving_fallback_calorie_basis_count'],
		'serving_fallback_signature_accepted' => $nutrition['serving_fallback_signature_accepted'],
		'serving_fallback_signature_rejection_reason' => $nutrition['serving_fallback_signature_rejection_reason'],
		'seo_hash'                  => nkt_gpt_par_0723_seo_hash( $post_id ),
		'schema_hash'               => nkt_gpt_par_0723_schema_hash( $post_id ),
		'ratings_reviews_hash'      => $ratings['hash'],
		'ratings_reviews_count'     => $ratings['count'],
		'protected_post_meta_hash'  => nkt_gpt_par_0723_hash( $protected_meta ),
		'media_reference_hash'      => $media['reference_hash'],
		'media_alt_text_hash'       => $media['alt_text_hash'],
		'media_non_alt_hash'        => $media['non_alt_hash'],
		'media_manifest'            => $media,
		'amazon_destinations'       => $amazon['destinations'],
		'amazon_link_count'         => $amazon['count'],
		'affiliate_identifiers'     => $amazon['affiliate_identifiers'],
		'amazon_manifest_hash'      => $amazon['hash'],
		'amazon_unique_destination_count' => $amazon['unique_destination_count'],
		'amazon_raw_link_count'      => $amazon['raw_link_count'],
		'reusable_block_ids'         => $amazon['reusable_block_ids'],
		'reusable_block_hashes'      => $amazon['reusable_block_hashes'],
		'reusable_block_occurrences' => $amazon['reusable_block_occurrences'],
		'unresolved_reusable_blocks' => $amazon['unresolved_reusable_blocks'],
		'expanded_article_source_hash'=> $amazon['expanded_source_hash'],
		'link_manifest'              => $links,
		'intentional_multi_recipe_exception' => $exception,
		'category_ids'              => nkt_gpt_par_0723_sorted_ids( wp_get_post_categories( $post_id ) ),
		'tag_ids'                   => nkt_gpt_par_0723_sorted_ids( wp_get_post_tags( $post_id, array( 'fields' => 'ids' ) ) ),
	);
}

/** Capture draft article evidence and protected content-derived state. */
function nkt_gpt_par_0723_capture_draft_state( $draft_id ) {
	$draft = get_post( $draft_id );
	if ( ! $draft || 'post' !== $draft->post_type || ! in_array( $draft->post_status, array( 'draft', 'pending', 'private' ), true ) ) {
		return new WP_Error( 'nkt_gpt_par_draft_not_found', __( 'The protected article revision draft was not found.', 'nkt-gpt-connector' ), array( 'status' => 404 ) );
	}
	$recipe_ids = function_exists( 'nkt_gpt_connector_get_wprm_recipe_ids' ) ? nkt_gpt_connector_get_wprm_recipe_ids( $draft->post_content ) : array();
	$nutrition  = nkt_gpt_par_0723_nutrition_manifest( $draft->post_content );
	$media      = nkt_gpt_par_0723_media_manifest( $draft->post_content );
	$amazon     = nkt_gpt_par_0723_amazon_manifest( $draft->post_content );
	$expanded_links = nkt_gpt_par_0723_expand_reusable_blocks( $draft->post_content );
	$links      = nkt_gpt_par_0723_link_manifest( $expanded_links['expanded_content'] );

	return array(
		'draft_post_id'            => (int) $draft->ID,
		'draft_status'             => $draft->post_status,
		'content_hash'             => hash( 'sha256', (string) $draft->post_content ),
		'excerpt_hash'             => hash( 'sha256', (string) $draft->post_excerpt ),
		'ordered_wprm_recipe_ids'  => array_values( array_map( 'absint', $recipe_ids ) ),
		'wprm_reference_count'     => count( $recipe_ids ),
		'nutrition_section_hash'   => $nutrition['section_hash'],
		'serving_label'            => $nutrition['serving_label'],
		'serving_label_hash'       => $nutrition['serving_hash'],
		'serving_label_source'      => $nutrition['serving_label_source'],
		'serving_label_block_path'  => $nutrition['serving_label_block_path'],
		'parsed_nutrition_section_count' => $nutrition['parsed_nutrition_section_count'],
		'matching_visible_serving_h3_count' => $nutrition['matching_visible_serving_h3_count'],
		'serving_fallback_accepted' => $nutrition['serving_fallback_accepted'],
		'serving_fallback_rejection_reason' => $nutrition['serving_fallback_rejection_reason'],
		'serving_fallback_gate' => $nutrition['serving_fallback_gate'],
		'serving_fallback_raw_serving_h3_count' => $nutrition['serving_fallback_raw_serving_h3_count'],
		'serving_fallback_segment_nutrition_marker_count' => $nutrition['serving_fallback_segment_nutrition_marker_count'],
		'serving_fallback_article_nutrition_marker_count' => $nutrition['serving_fallback_article_nutrition_marker_count'],
		'serving_fallback_nutrient_label_count' => $nutrition['serving_fallback_nutrient_label_count'],
		'serving_fallback_daily_value_marker_count' => $nutrition['serving_fallback_daily_value_marker_count'],
		'serving_fallback_calorie_basis_count' => $nutrition['serving_fallback_calorie_basis_count'],
		'serving_fallback_signature_accepted' => $nutrition['serving_fallback_signature_accepted'],
		'serving_fallback_signature_rejection_reason' => $nutrition['serving_fallback_signature_rejection_reason'],
		'media_reference_hash'     => $media['reference_hash'],
		'media_alt_text_hash'      => $media['alt_text_hash'],
		'media_non_alt_hash'       => $media['non_alt_hash'],
		'media_manifest'           => $media,
		'amazon_destinations'      => $amazon['destinations'],
		'amazon_link_count'        => $amazon['count'],
		'affiliate_identifiers'    => $amazon['affiliate_identifiers'],
		'amazon_manifest_hash'     => $amazon['hash'],
		'amazon_unique_destination_count' => $amazon['unique_destination_count'],
		'amazon_raw_link_count'     => $amazon['raw_link_count'],
		'reusable_block_ids'        => $amazon['reusable_block_ids'],
		'reusable_block_hashes'     => $amazon['reusable_block_hashes'],
		'reusable_block_occurrences'=> $amazon['reusable_block_occurrences'],
		'unresolved_reusable_blocks'=> $amazon['unresolved_reusable_blocks'],
		'expanded_article_source_hash'=> $amazon['expanded_source_hash'],
		'link_manifest'             => $links,
	);
}

/** Return valid literal WordPress post statuses for protected recipe guards. */